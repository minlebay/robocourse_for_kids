# Database (PostgreSQL). For docker compose use postgres://postgres:postgres@db:5432/learn_kids?sslmode=disable
DATABASE_URL=postgres://postgres:postgres@localhost:5432/learn_kids?sslmode=disable

# Port for API
PORT=8080

# Secret for JWT signing (change in production)
JWT_SECRET=change-me-in-production

# Allowed frontend origin for CORS (при фронте на том же хосте — тот же порт)
FRONTEND_ORIGIN=http://localhost:8080

# Google Gemini API key for lesson chat (optional; without it chat is disabled)
GEMINI_API_KEY=
